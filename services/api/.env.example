# Copy to .env and fill in real values for your environment. Every value here
# has a safe local-dev default in src/config/env.ts EXCEPT secrets, which you
# should always set explicitly outside of local development.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://veynlo:veynlo_dev_password@localhost:5433/veynlo
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# Generate real random values (e.g. `openssl rand -base64 32`) for these three in every non-local
# environment — the API refuses to start in production if any is still set to its dev default or is
# shorter than 32 characters (see src/config/env.ts's PRODUCTION_REQUIRED_SECRETS check).
SESSION_JWT_SECRET=dev-only-insecure-secret-change-me
CREDENTIAL_ENCRYPTION_KEY=dev-only-32-byte-key-change-me!!
# Encrypts sensitive row/field content at rest (§SEC-ROW) — see packages/db/src/crypto/field-encryption.ts.
# Separate key from CREDENTIAL_ENCRYPTION_KEY so the two data classes rotate independently.
FIELD_ENCRYPTION_KEY=dev-only-field-encryption-key-change-me
# Which version number FIELD_ENCRYPTION_KEY is — every row encrypted under it is tagged with this number.
# Defaults to 1. Bump it by hand every time FIELD_ENCRYPTION_KEY itself changes (never reuse a number).
FIELD_ENCRYPTION_KEY_VERSION=1
# Set only while rotating: the outgoing key and the version number it was tagged with, kept decrypt-only
# until a backfill has rewritten every row still under it (see the module doc comment for the full
# rotation procedure). Leave both unset otherwise. Required together — setting one without the other is
# a startup error.
FIELD_ENCRYPTION_KEY_PREVIOUS=
FIELD_ENCRYPTION_KEY_PREVIOUS_VERSION=

WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3100
API_PUBLIC_URL=http://localhost:4000

# --- Connectors (leave unset in dev; connections show a clear "not configured" state) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# --- AI (leave unset to run with deterministic parsers only) ---
ANTHROPIC_API_KEY=

# --- Malware scanning (ClamAV) for document uploads ---
# Leave unset to skip scanning in local dev (uploads still work, just unscanned). `docker compose up -d
# clamav` starts a real scanner on localhost:3310 — set CLAMD_HOST=127.0.0.1 to use it. Once configured,
# a scan failure fails CLOSED (rejects the upload) rather than accepting an unscanned file.
CLAMD_HOST=
CLAMD_PORT=3310

# --- Object storage (MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=veynlo
S3_SECRET_ACCESS_KEY=veynlo_dev_password
S3_BUCKET=veynlo-documents
S3_FORCE_PATH_STYLE=true

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Cross-platform (Apple/Google/web) entitlement normalization. Leave unset in dev — the webhook route
# shows a clear "not configured" state. Set to whatever value you configure as the webhook's
# Authorization header in the RevenueCat dashboard once a RevenueCat project exists.
REVENUECAT_WEBHOOK_AUTH_HEADER=

# --- Outbound email (defaults target the local Mailhog container — see http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=noreply@veynlo.app

# --- Admin (per-operator accounts in the admin_users table — create one with
#     `pnpm --filter @veynlo/api run create-admin -- --email you@veynlo.app`) ---
