# Copy to .env and fill in real values for your environment. Every value here
# has a safe local-dev default in src/config/env.ts EXCEPT secrets, which you
# should always set explicitly outside of local development.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://veynlo:veynlo_dev_password@localhost:5433/veynlo
REDIS_URL=redis://localhost:6379

# Generate real random values for these two in every non-local environment.
SESSION_JWT_SECRET=dev-only-insecure-secret-change-me
CREDENTIAL_ENCRYPTION_KEY=dev-only-32-byte-key-change-me!!

WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3100
API_PUBLIC_URL=http://localhost:4000

# --- Connectors (leave unset in dev; connections show a clear "not configured" state) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# --- AI (leave unset to run with deterministic parsers only) ---
ANTHROPIC_API_KEY=

# --- Object storage (MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=veynlo
S3_SECRET_ACCESS_KEY=veynlo_dev_password
S3_BUCKET=veynlo-documents
S3_FORCE_PATH_STYLE=true

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Outbound email (defaults target the local Mailhog container — see http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=noreply@veynlo.app

# --- Admin (per-operator accounts in the admin_users table — create one with
#     `pnpm --filter @veynlo/api run create-admin -- --email you@veynlo.app`) ---
