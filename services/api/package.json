{
  "name": "@veynlo/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "nest start --watch",
    "worker:dev": "tsx watch src/worker-main.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker-main.js",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "rotate-credential-vault-key": "tsx src/scripts/rotate-credential-vault-key.ts",
    "backfill-search-documents": "tsx src/scripts/backfill-search-documents.ts",
    "eval:extraction": "tsx src/modules/intelligence/eval/run-golden-set-eval.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^9.0.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@simplewebauthn/server": "^13.3.3",
    "@veynlo/core": "workspace:*",
    "@veynlo/db": "workspace:*",
    "@xenova/transformers": "^2.17.2",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.6",
    "drizzle-orm": "^0.38.3",
    "expo-server-sdk": "^7.2.0",
    "fastify": "^5.2.0",
    "ffmpeg-static": "^5.3.0",
    "googleapis": "^144.0.0",
    "heic-convert": "^2.1.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "nestjs-pino": "^4.6.1",
    "node-ical": "^0.27.1",
    "nodemailer": "^9.1.0",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^17.5.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/heic-convert": "^2.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
