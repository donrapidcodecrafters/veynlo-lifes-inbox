EXPO_PUBLIC_API_URL=http://localhost:4000

# RevenueCat public SDK keys (from the RevenueCat dashboard, one per store) — native IAP is disabled
# gracefully ("In-app purchases aren't available on this build yet.") when unset, same "optional in dev"
# pattern as REVENUECAT_WEBHOOK_AUTH_HEADER on the API side.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
