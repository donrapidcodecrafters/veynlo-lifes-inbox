{
  "manifest_version": 3,
  "name": "Veynlo",
  "version": "1.0.0",
  "description": "Save pages, products, articles, and receipts to Veynlo in one click.",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-extension@veynlo.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ],
        "optional": []
      }
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Save to Veynlo"
  },
  "background": {
    "scripts": [
      "background/background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:4000/*",
    "http://localhost:3000/*"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
