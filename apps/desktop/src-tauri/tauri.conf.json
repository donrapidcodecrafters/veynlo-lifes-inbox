{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veynlo",
  "version": "0.1.0",
  "identifier": "app.veynlo.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self' http://localhost:3000 https://app.veynlo.com https://api.veynlo.com https://auth.veynlo.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["pdf"], "name": "PDF Document", "mimeType": "application/pdf", "description": "Send to Life Inbox" },
      { "ext": ["png"], "name": "PNG Image", "mimeType": "image/png", "description": "Send to Life Inbox" },
      { "ext": ["jpg", "jpeg"], "name": "JPEG Image", "mimeType": "image/jpeg", "description": "Send to Life Inbox" },
      { "ext": ["heic"], "name": "HEIC Image", "mimeType": "image/heic", "description": "Send to Life Inbox" }
    ]
  }
}
