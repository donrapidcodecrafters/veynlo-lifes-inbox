{
  "name": "@veynlo/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed/run.ts",
    "seed:reference-data": "tsx src/seed/reference-data.ts",
    "seed:identity-jurisdiction-links": "tsx src/seed/identity-jurisdiction-links.ts",
    "seed:merchant-cancellation-steps": "tsx src/seed/merchant-cancellation-steps.ts",
    "seed:model-registry": "tsx src/seed/model-registry.ts",
    "backup": "tsx src/scripts/backup.ts",
    "restore-drill": "tsx src/scripts/restore-drill.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@veynlo/core": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6",
    "@types/pg": "^8.11.10"
  }
}
